+
+/* minimal ethtool ops for kernel 6.12 (the original block does not build).
+ * Speed/link and Wake-on-LAN go straight to the attached PHY (netdev->phydev). */
+static void al_eth_min_get_wol(struct net_device *netdev, struct ethtool_wolinfo *wol)
+{
+	wol->supported = 0; wol->wolopts = 0;
+	if (netdev->phydev)
+		phy_ethtool_get_wol(netdev->phydev, wol);
+}
+static int al_eth_min_set_wol(struct net_device *netdev, struct ethtool_wolinfo *wol)
+{
+	int rc;
+	if (!netdev->phydev)
+		return -EOPNOTSUPP;
+	rc = phy_ethtool_set_wol(netdev->phydev, wol);
+	if (!rc)
+		device_set_wakeup_enable(&netdev->dev, !!wol->wolopts);
+	return rc;
+}
+static const struct ethtool_ops al_eth_ethtool_ops_min = {
+	.get_link		= ethtool_op_get_link,
+	.get_wol		= al_eth_min_get_wol,
+	.set_wol		= al_eth_min_set_wol,
+};
+
