#!/bin/busybox sh
# Initramfs for the QNAP TS-431P3.
#  - kernel command line without "rootmd": test mode, Linux runs in RAM only, disks are NOT mounted or written;
#  - with "rootmd": assemble the RAID arrays and boot Debian from /dev/md0;
#  - with "debroot=<server>:<path>": boot Debian from NFS (disks not mounted).
/bin/busybox --install -s /bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
echo
echo "=== TS-431P3 initramfs ==="
uname -a
echo "cores: $(grep -c ^processor /proc/cpuinfo)"
free -m
echo "--- loading al_eth"
insmod /lib/modules/al_eth.ko && echo "al_eth LOADED" || echo "al_eth ERROR"
echo "--- waiting for disks (max 30 s)"
i=0
while ! grep -q " sd" /proc/partitions && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
cat /proc/partitions
# Boot Debian from the disks ("rootmd" on the kernel command line)
if grep -q rootmd /proc/cmdline; then
  echo "--- assembling RAID arrays"
  mkdir -p /etc/mdadm /newroot
  cp /etc/mdadm.conf /etc/mdadm/mdadm.conf 2>/dev/null
  i=0; while [ ! -b /dev/sdc1 ] && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
  /sbin/mdadm --assemble --scan --config=/etc/mdadm.conf 2>&1
  cat /proc/mdstat
  if mount -o ro -t ext4 /dev/md0 /newroot && [ -x /newroot/sbin/init ]; then
    echo "--- switching to Debian on md0"
    umount /proc /sys 2>/dev/null; mount --move /dev /newroot/dev 2>/dev/null
    exec switch_root /newroot /sbin/init
  fi
  echo "!!! cannot mount md0: emergency shell on the serial console"
  while true; do setsid cttyhack sh; done
fi
echo "--- network interfaces"
# Set YOUR MAC addresses (NAS label or QTS): eth0 = 2.5 GbE, eth1 = 1 GbE
ip link set eth0 address xx:xx:xx:xx:xx:b2 2>/dev/null
ip link set eth1 address xx:xx:xx:xx:xx:b3 2>/dev/null
for n in $(ls /sys/class/net | grep -v lo); do timeout 5 ip link set $n up 2>&1; done
sleep 8
for n in $(ls /sys/class/net | grep -v lo); do
  c=$(cat /sys/class/net/$n/carrier 2>/dev/null)
  echo "$n carrier=$c"
  [ "$c" = 1 ] && timeout 30 udhcpc -i $n -n -q -t 5 -s /bin/dhcp.sh 2>&1 | tail -1
done
ip -o -4 addr
# Boot Debian from NFS if requested (disks not mounted)
R=$(sed -n 's/.*debroot=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$R" ]; then
  echo "--- mounting Debian from $R"
  mkdir -p /newroot
  if mount -t nfs -o nolock,vers=3,tcp "$R" /newroot && [ -x /newroot/sbin/init ]; then
    echo "--- switching to Debian"
    umount /proc /sys 2>/dev/null; mount --move /dev /newroot/dev 2>/dev/null
    exec switch_root /newroot /sbin/init
  fi
  echo "!!! NFS mount failed, staying in the test system"
fi
echo "=== READY (serial console) ==="
while true; do setsid cttyhack sh; done
