+/*
+ * HDD LEDs of the QNAP TS-431P3, driven by GPIOs as in QTS
+ * (al_ahci_transmit_led_message in QNAP libahci.c, node "annapurna-labs,al-sata-sw-leds").
+ * Logical 1 = LED on (polarity in the DTB). Off when the port has no disk.
+ */
+static bool al_led_inverti;
+module_param_named(led_inverti, al_led_inverti, bool, 0644);
+MODULE_PARM_DESC(led_inverti, "invert the QNAP HDD LEDs (GPIO polarity)");
+
+static ssize_t al_ahci_transmit_led_message(struct ata_port *ap, u32 state,
+					    ssize_t size)
+{
+	struct ahci_host_priv *hpriv = ap->host->private_data;
+	struct ahci_port_priv *pp = ap->private_data;
+	int pmp = (state & EM_MSG_LED_PMP_SLOT) >> 8;
+	struct gpio_desc *g;
+
+	if (pmp >= EM_MAX_SLOTS || ap->port_no >= AHCI_MAX_PORTS || !pp)
+		return -EINVAL;
+	g = hpriv->led_gpio[ap->port_no];
+	if (!g)
+		return -EINVAL;
+	gpiod_set_value(g, (!(state & EM_MSG_LED_VALUE_ON) &&
+			    ata_link_online(&ap->link)) ^ al_led_inverti);
+	pp->em_priv[pmp].led_state = state;
+	return size;
+}
+
+static struct ata_port_operations ahci_al_ops = {
+	.inherits		= &ahci_ops,
+	.transmit_led_message	= al_ahci_transmit_led_message,
+};
+
+static void ahci_al_leds_init(struct pci_dev *pdev, struct ahci_host_priv *hpriv,
+			      struct ata_port_info *pi)
+{
+	struct device_node *np, *child;
+	u32 dom, bus, dev, port;
+
+	np = of_find_compatible_node(NULL, NULL, "annapurna-labs,al-sata-sw-leds");
+	if (!np)
+		return;
+	for_each_child_of_node(np, child) {
+		struct gpio_desc *g;
+
+		if (of_property_read_u32(child, "pci_domain", &dom) ||
+		    dom != pci_domain_nr(pdev->bus) ||
+		    of_property_read_u32(child, "pci_bus", &bus) ||
+		    bus != pdev->bus->number ||
+		    of_property_read_u32(child, "pci_dev", &dev) ||
+		    dev != PCI_SLOT(pdev->devfn) ||
+		    of_property_read_u32(child, "port", &port) ||
+		    port >= AHCI_MAX_PORTS)
+			continue;
+		g = devm_fwnode_gpiod_get_index(&pdev->dev, of_fwnode_handle(child),
+						NULL, 0, GPIOD_OUT_LOW, "sata led");
+		if (IS_ERR(g)) {
+			dev_warn(&pdev->dev, "LED port %u: gpio not available (%ld)\n",
+				 port, PTR_ERR(g));
+			continue;
+		}
+		hpriv->led_gpio[port] = g;
+		hpriv->em_msg_type = EM_MSG_TYPE_LED;
+		pi->flags |= ATA_FLAG_EM | ATA_FLAG_SW_ACTIVITY;
+		pi->port_ops = &ahci_al_ops;
+		dev_info(&pdev->dev, "LED port %u on GPIO\n", port);
+	}
+	of_node_put(np);
+}
+
