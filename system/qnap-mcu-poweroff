#!/bin/sh
# Real power-off for the QNAP TS-431P3.
# The microcontroller (MCU) on /dev/ttyS1 at 115200 baud controls the power supply.
# Command "@C0" + XOR checksum (0x33 = "3"). Runs ONLY at the very end of shutdown,
# when the disks are already unmounted: sent earlier, it would cut power to the disks.
[ "$1" = poweroff ] || exit 0
stty -F /dev/ttyS1 115200 cs8 -cstopb -parenb -crtscts -ixon -ixoff raw -echo
printf "@C03" > /dev/ttyS1
sleep 2
